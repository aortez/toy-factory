#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

&pinctrl {
	picosystem_spi0_default: picosystem_spi0_default {
		group1 {
			pinmux = <SPI0_SCK_P6>, <SPI0_TX_P7>;
		};
	};

	picosystem_pwm_default: picosystem_pwm_default {
		group1 {
			pinmux = <PWM_5B_P11>, <PWM_6A_P12>;
		};
	};
};
