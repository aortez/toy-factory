/dts-v1/;

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "picosystem-pinctrl.dtsi"

/ {
	model = "Pimoroni PicoSystem PIM559";
	compatible = "pimoroni,picosystem";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
		zephyr,display = &lcd;
	};

	aliases {
		led0 = &led_blue;
		sw0 = &button_x;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "PicoSystem RGB red";
		};

		led_green: led_green {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "PicoSystem RGB green";
		};

		led_blue: led_blue {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "PicoSystem RGB blue";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button_up: button_up {
			gpios = <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Up";
			zephyr,code = <INPUT_KEY_UP>;
		};

		button_down: button_down {
			gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Down";
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		button_left: button_left {
			gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Left";
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		button_right: button_right {
			gpios = <&gpio0 21 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Right";
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		button_a: button_a {
			gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "A";
			zephyr,code = <INPUT_KEY_A>;
		};

		button_b: button_b {
			gpios = <&gpio0 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "B";
			zephyr,code = <INPUT_KEY_B>;
		};

		button_x: button_x {
			gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "X";
			zephyr,code = <INPUT_KEY_X>;
		};

		button_y: button_y {
			gpios = <&gpio0 16 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Y";
			zephyr,code = <INPUT_KEY_Y>;
		};
	};

	pwm_leds {
		compatible = "pwm-leds";

		lcd_backlight: lcd-backlight {
			pwms = <&pwm 12 PWM_USEC(50) PWM_POLARITY_NORMAL>;
			label = "PicoSystem LCD backlight";
		};
	};

	lcd_mipi_dbi: mipi-dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		lcd: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <20000000>;
			width = <240>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x25>;
			gctrl = <0x14>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x04>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
			nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			status = "okay";
		};
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_M(16)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(16)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		second_stage_bootloader: partition@0 {
			label = "second_stage_bootloader";
			reg = <0x00000000 0x100>;
			read-only;
		};

		code_partition: partition@100 {
			label = "code-partition";
			reg = <0x100 (DT_SIZE_M(16) - 0x100)>;
			read-only;
		};
	};
};

&gpio0 {
	status = "okay";
};

&pwm {
	pinctrl-0 = <&picosystem_backlight_pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&picosystem_spi0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&timer {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&vreg {
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>
